# =============================================================================
# RCT MP · 环境变量模板（.env.example）
# -----------------------------------------------------------------------------
# 用法：
#   1. 本地开发：复制成 .env.local，把每个 <...> 占位符替换成真实值。
#      （.env.local 不会进 Git：.gitignore 里有 `.env*`，不要把真实密钥提交。）
#   2. 生产环境：Vercel → Project → Settings → Environment Variables，
#      逐条添加。Production / Preview 都要配，改完必须 Redeploy 才生效。
#   3. 本文件里【没有任何真实值】，所有占位符都必须替换。
#
# ⚠️ 三条铁律：
#   1. 只有 NEXT_PUBLIC_ 开头的变量会被打包进浏览器代码 —— 换句话说，
#      **任何加 NEXT_PUBLIC_ 前缀的变量都等于公开**。
#   2. SUPABASE_SERVICE_ROLE_KEY / STEAM_API_KEY / AUTH_SECRET
#      绝对不能加 NEXT_PUBLIC_，也不能在 'use client' 文件里引用。
#   3. 轮换密钥后要同时更新 Vercel env 并重新部署，否则线上会继续用旧值。
#
# 变量总览：
#   [1] NEXT_PUBLIC_SUPABASE_URL      Supabase 项目地址       浏览器可见
#   [2] NEXT_PUBLIC_SUPABASE_ANON_KEY Supabase 匿名密钥       浏览器可见（安全前提 = RLS）
#   [3] SUPABASE_SERVICE_ROLE_KEY     Supabase 服务端密钥     仅服务端，泄露=全库沦陷
#   [4] STEAM_API_KEY                 Steam Web API Key       仅服务端
#   [5] AUTH_SECRET                   签名密钥（本次新增）    仅服务端
#   [6] NEXTAUTH_URL                  站点公开地址            预留 / 回跳基址
#   [7] RCTMP_*                       游戏服状态页（服务器列表）  仅服务端
# =============================================================================


# -----------------------------------------------------------------------------
# [1] NEXT_PUBLIC_SUPABASE_URL
# 作用：Supabase 项目 URL。前端所有 createClient() 和服务端 admin client 都用它。
# 取值：Supabase Dashboard → Project Settings → Data API / API → Project URL
#       线上应为 https://undmtiotuffrqcfvqand.supabase.co
#       本地 supabase start 时是 http://127.0.0.1:54321
# 注意：必须是 https（生产），结尾不要带斜杠。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co


# -----------------------------------------------------------------------------
# [2] NEXT_PUBLIC_SUPABASE_ANON_KEY
# 作用：前端匿名密钥（anon / publishable key）。用它 + 用户 JWT 走 PostgREST，
#       能做什么完全由数据库 RLS 决定。
# 取值：Supabase Dashboard → Project Settings → API → Project API keys → anon public
#       （新版 Dashboard 里叫 "publishable key"，值形如 eyJ... 或 sb_publishable_...）
# ⚠️ 它不是"秘密"，但在执行 supabase/p0-hardening.sql 之前，
#    它等价于数据库的完整读写权限（因为没有 RLS 策略兜底）。
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-publishable-key>


# -----------------------------------------------------------------------------
# [3] SUPABASE_SERVICE_ROLE_KEY
# 作用：服务端高权限密钥，**绕过所有 RLS**。目前只用于：
#       - app/api/auth/steam/bind（把验证结果写进 profiles）
#       - app/api/auth/steam/callback（settings 绑定分支）
#       即：steam_id / steam_verified 这两列只能被它写，客户端永远改不了。
# 取值：Supabase Dashboard → Project Settings → API → Project API keys → service_role
# ⚠️⚠️ 绝不能加 NEXT_PUBLIC_ 前缀；绝不能出现在 'use client' 组件里；
#      绝不能出现在浏览器可见的错误信息 / 日志里。
#      一旦泄露（例如被打进前端 bundle），任何人都能读写整库、扫掉所有用户数据，
#      RLS 完全失效。怀疑泄露时：Dashboard → Settings → API → 轮换密钥，
#      然后更新 Vercel env + 重新部署。
# ⚠️ 本地开发用不到它就连注释掉，避免误用。
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>


# -----------------------------------------------------------------------------
# [4] STEAM_API_KEY
# 作用：调用 Steam Web API（IPlayerService/GetOwnedGames）核对
#       “是否拥有正版 ETS2 + 游玩时长 >= 120 分钟”。
# 取值：https://steamcommunity.com/dev/apikey
#       （需要登录 Steam；Domain 可填 www.roadcruise-mp.com 或 localhost）
# 注意：这是 Steam 账号级密钥，只放服务端。未配置时 Steam 验证会直接失败
#       （代码会返回 steam_service_misconfigured）。
# -----------------------------------------------------------------------------
STEAM_API_KEY=<steam-web-api-key>


# -----------------------------------------------------------------------------
# [5] AUTH_SECRET ★ 本次新增
# 作用：对 Steam 验证结果的签名 Cookie 做 HMAC-SHA256 签名，防止伪造。
#       涉及 lib/steam-token.ts 里的两个 HttpOnly Cookie：
#         rct_steam_pending（注册闸门，10 分钟）
#         rct_steam_state  （OpenID state，10 分钟）
#       签名流程：base64url(payload) + "." + base64url(HMAC-SHA256(payload, AUTH_SECRET))
#       校验用 timingSafeEqual，签名不符 / 过期 / 缺密钥一律视为无效。
# 生成方式（推荐，64 个 hex 字符 = 32 字节随机）：
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#       或者 PowerShell：
#       [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Max 256 })).ToLower()
# 要求：
#       - 至少 16 字符（代码里 < 16 会直接抛错，Steam 验证整条链路会 500）；
#       - 生产 / 预览 / 本地建议用不同值；
#       - 轮换它会让所有"正在进行中"的 Steam 验证失效（用户需重新点一次验证），
#         已入库的 steam_verified 不受影响。
# -----------------------------------------------------------------------------
AUTH_SECRET=<64-hex-random-字符>


# -----------------------------------------------------------------------------
# [6] NEXTAUTH_URL
# 作用：站点公开地址（协议 + 域名 + 端口，不带结尾斜杠）。
#       当前代码没有接入 next-auth，实际回跳域名取自 req.nextUrl.origin；
#       保留它是为了两件事：
#       (a) 以后接入 next-auth 时直接复用；
#       (b) 部署在反向代理 / 自定义域名后，需要固定"对外可见的站点地址"时使用。
# 取值：本地 http://localhost:3000    生产 https://www.roadcruise-mp.com
# ⚠️ Steam OpenID 的 realm / return_to 必须与浏览器实际访问的域名完全一致
#    （http/https、www 与非 www 都算不同），否则 Steam 会拒绝回跳。
#    如果线上同时绑定了 roadcruise-mp.com 与 www.roadcruise-mp.com，
#    请统一 301 到其中一个，避免绑定流程随机失败。
# -----------------------------------------------------------------------------
NEXTAUTH_URL=https://www.roadcruise-mp.com


# -----------------------------------------------------------------------------
# [7] 游戏服务器状态 API（RCTMP GameServer，规格见上游仓库 docs/api.md 与本仓库 docs/API-INTEGRATION.md）
# 状态：已落地（lib/server-status.ts + app/api/servers/status + /servers 页面）。
# 作用：服务端代理 GET /api/servers/status 会去请求游戏服务端的 GET /status，
#       用于「服务器列表」页与导航栏在线人数。浏览器不直连（对方不返回 CORS 头）。
# 取值：本地 http://127.0.0.1:8080（启动器/服务端默认端口）
#       生产由运维分配 HTTPS 地址（反代后只暴露 HTTPS）
# 注意：
#       - 这些变量只在服务端使用（lib/server-status.ts），不要加 NEXT_PUBLIC_；
#       - 对方启动时若带 --api-key，则必须配置 RCTMP_API_KEY，否则 /status 返回 401；
#       - RCTMP_SERVERS 用于多台服务器（JSON 数组），配置后优先于单台三项：
#         [{"id":"rct1","name":"...","baseUrl":"https://...","apiKey":"..."}]
#       - 服务器 id 用启动器深链 rctmp://connect?server=<id>，一旦上线不要改。
#       - 未配置时 /servers 显示"尚未配置服务器"，其它页面不受影响。
# -----------------------------------------------------------------------------
RCTMP_API_BASE_URL=http://127.0.0.1:8080
RCTMP_SERVER_ID=rct1
RCTMP_SERVER_NAME=RCTMP 路驰 · RCT1
# RCTMP_API_KEY=<optional-api-key>
# RCTMP_SERVERS=[{"id":"rct1","name":"RCTMP 路驰 · RCT1","baseUrl":"https://gameserver.example.com"}]



# =============================================================================
# 附：安全自检（部署前在本地跑一遍）
# -----------------------------------------------------------------------------
# 1) 确认 service_role key 没有被打进前端产物：
#      npm run build
#      Select-String -Path .next\static\**\*.js -Pattern "service_role" -SimpleMatch
#    （应当没有任何匹配。若匹配到，说明某处把 service_role 用在了客户端组件里。）
#
# 2) 确认 .env.local / .env 不会被提交：
#      git check-ignore -v .env.local
#    .gitignore 已改为 `.env*` + `!.env.example`，本模板文件可以正常提交；
#    真实密钥文件（.env.local / .env.production 等）仍然被忽略。
#
# 3) 确认生产环境变量齐全（Vercel CLI）：
#      vercel env ls
#    上面 [1]~[7] 的变量缺任何一个都会在运行期报错
#    （AUTH_SECRET 缺失时 Steam 验证直接 500；RCTMP_API_BASE_URL 缺失时服务器列表页显示未配置）。
# =============================================================================
